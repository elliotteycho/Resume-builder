# Anthropic API key — get one at https://platform.claude.com/
# Needed for matching, research, resume import, and generation. The tracker
# itself runs without it.
ANTHROPIC_API_KEY=sk-ant-...

# ---- Multi-user mode (optional) ----
# Leave these unset to run local-first: one user, data in data/hq.json.
# Set all three to switch to Supabase (auth + Postgres). Apply the migrations
# in supabase/migrations/ first, then create an invite code (see README).
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# SUPABASE_SERVICE_ROLE_KEY=eyJ...   # server-only; never expose to the client

# Global monthly ceiling for AI spend across all users, in dollars.
# When it's reached, metered features pause until the 1st; tracking keeps working.
# HQ_SPEND_CAP_USD=50
